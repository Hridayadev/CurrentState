# Backend (Fastify API) environment — copy to .env and fill in real values.
# These variables are server-only and MUST never be prefixed NEXT_PUBLIC_
# or shipped to the browser.

# HTTP port the API listens on
PORT=3001

# --- Reserved for privileged backend access (uncomment when needed) ----------
# Only required if the API talks to Supabase directly (e.g. admin/service-role
# operations, webhooks, scheduled jobs). Never expose these to the frontend.
#
# SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=sb_secret_YOUR_SERVICE_ROLE_KEY
# JWT_SECRET=your-supabase-jwt-secret
