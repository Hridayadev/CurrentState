# Frontend (Next.js) environment — copy to .env.local and fill in real values.
# NEXT_PUBLIC_* values are inlined into the client bundle at build time, so they
# must be PUBLIC-safe (the Supabase publishable key is designed for this).
#
# Supabase project URL
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# Supabase publishable key (from Dashboard > Project Settings > API)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_PUBLISHABLE_KEY
